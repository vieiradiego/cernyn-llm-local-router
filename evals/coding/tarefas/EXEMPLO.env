# Caminho do repo-alvo nesta máquina (obrigatório)
REPO=${EVAL_REPO:?defina EVAL_REPO com o caminho do repo-alvo}
# Replay: commit PAI do gabarito e o commit do gabarito (os testes de referência vêm dele)
BASE_SHA=<sha-pai>
REF_SHA=<sha-gabarito>
ACCEPT_E2E="tests/e2e/<spec>.spec.ts"
ACCEPT_UNIT=""
FORBIDDEN="content/ infra/"
# Tarefa viva: REF_SHA vazio e um comando de aceite (rc 0 = passou)
# ACCEPT_CMD='grep -q "algo" arquivo && npm run lint'
